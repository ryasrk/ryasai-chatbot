# =============================================================================
# ryasai — environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# =============================================================================

# --- Database -----------------------------------------------------------------
# SQLite file path (dev). Use a real DB URL in production.
DATABASE_URL=file:./db/custom.db

# --- Secrets (SERVER-ONLY, fail-closed) ---------------------------------------
# AES-256-GCM key for encrypting integration configs + LLM API keys.
# Generate one with:  openssl rand -hex 32
# Must be 64 hex chars OR any passphrase (derived via SHA-256).
# REQUIRED — the app refuses to start without it (no insecure fallback).
ENCRYPTION_SECRET_KEY=

# --- Auth ---------------------------------------------------------------------
# When true and no session cookie is present, the server impersonates the first
# admin user so the demo UI works without a login screen. MUST be false in any
# multi-tenant / production deployment. Defaults to true outside production.
AUTH_DEMO_FALLBACK=true

# Single admin login (used by seed + setup wizard).
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me

# --- Server ports -------------------------------------------------------------
# Next.js web server (dev: package.json script also honours $PORT).
PORT=3000
# socket.io chat mini-service.
WS_PORT=3003
# Caddy reverse proxy (production only — see Caddyfile).
CADDY_PORT=81
WEB_PORT=3000

# --- Database logging ---------------------------------------------------------
# Log every SQL statement (incl. params) to stdout. Noisy + leaks data. Off by default.
DB_QUERY_LOG=false

# --- WebSocket CORS -----------------------------------------------------------
# Comma-separated allowed origins for the chat mini-service. Empty = reflect the
# request Origin. NEVER use a wildcard in production.
# Example: https://app.ryas.ai,https://staging.ryas.ai
WS_CORS_ORIGIN=

# --- Client-visible (NEXT_PUBLIC_* are inlined into the browser bundle) -------
# App version shown in the UI footer/sidebar (defaults from package.json at build).
NEXT_PUBLIC_APP_VERSION=2.0.0
# WebSocket port the browser client connects to.
NEXT_PUBLIC_WS_PORT=3003
