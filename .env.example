# =============================================================================
# ryasai — environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# =============================================================================

# --- Database -----------------------------------------------------------------
# PostgreSQL 16+ with the `vector` extension (pgvector). SQLite is NOT supported —
# the Prisma schema requires postgresql + pgvector.
# Local dev:  postgresql://ryasai:ryasai_dev@localhost:5432/ryasai
# (create the DB once: sudo -u postgres createdb -O ryasai ryasai &&
#  sudo -u postgres psql -d ryasai -c 'CREATE EXTENSION IF NOT EXISTS vector;')
# Then: bunx prisma db push
DATABASE_URL=postgresql://ryasai:ryasai_dev@localhost:5432/ryasai

# --- Secrets (SERVER-ONLY, fail-closed) ---------------------------------------
# AES-256-GCM key for encrypting integration configs + LLM API keys.
# Generate one with:  openssl rand -hex 32
# Must be 64 hex chars OR any passphrase (derived via SHA-256).
# REQUIRED — the app refuses to start without it (no insecure fallback).
ENCRYPTION_SECRET_KEY=

# --- Auth ---------------------------------------------------------------------
# When true and no session cookie is present, the server impersonates the first
# admin user so the demo UI works without a login screen. MUST be false in any
# multi-tenant / production deployment. Code defaults to false (fail-closed);
# set to true for local dev convenience only.
AUTH_DEMO_FALLBACK=true

# Single admin login (used by seed + setup wizard).
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me

# --- Server ports -------------------------------------------------------------
# Next.js web server (dev: package.json script also honours $PORT).
PORT=3000
# socket.io chat mini-service.
WS_PORT=3003
# Caddy reverse proxy (production only — see Caddyfile).
CADDY_PORT=81
WEB_PORT=3000

# --- Redis (message broker + rate limiting — optional, graceful degradation) ----
# When set, background jobs (embedding, cognify, FTS rebuild) are queued via BullMQ.
# When unset or Redis is unreachable, the app falls back to synchronous processing.
# Production: use rediss:// for TLS-encrypted Redis transport.
# Dev: redis protocol without TLS is fine for localhost.
REDIS_URL=rediss://localhost:6379

# --- API rate limiting (defaults used when API key has no explicit limits) -----
DEFAULT_API_RATE_PER_MINUTE=60
DEFAULT_API_DAILY_LIMIT=1000

# --- Scheduler ---------------------------------------------------------------
# Poll interval in seconds for the scheduled-run worker (mini-services/scheduler).
SCHEDULER_POLL_INTERVAL_SEC=60

# --- Database logging ---------------------------------------------------------
# Log every SQL statement (incl. params) to stdout. Noisy + leaks data. Off by default.
DB_QUERY_LOG=false

# --- Observability (optional — LLM tracing/analytics platforms) ---------------
# Langfuse: self-hosted or cloud LLM observability. All three required if used.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASEURL=https://cloud.langfuse.com
# Helicone: LLM proxy + analytics. API key only.
# HELICONE_API_KEY=

# --- Contextual Retrieval (Anthropic technique — -49% retrieval failures) ----
# When true, each chunk is prepended with an LLM-generated document summary before
# embedding. Costs ~1 LLM call per document during ingestion. Off by default.
# CONTEXTUAL_RETRIEVAL=false

# --- RAG tuning (optional) ----------------------------------------------------
# LLM reranker: re-ranks retrieved chunks with an LLM 0-10 score (filters < 3).
# ON by default. Set false only if retrieval latency matters more than precision.
# RAG_LLM_RERANK=true
# Reranker service URL (cross-encoder, e.g. Cohere Rerank or self-hosted).
# When set, it replaces the LLM reranker (~100ms instead of an LLM call).
# RERANKER_URL=
# HyDE: generate a hypothetical answer before retrieval to improve semantic match.
# HYDE=false
# Reflexion: agentic loop self-corrects using prior attempt feedback.
# REFLEXION_ENABLED=false
# Parent-document chunking: split into child chunks, retrieve using parent window.
# PARENT_DOC_CHILD_SIZE=800
# PARENT_DOC_WINDOW=200

# --- Agentic loop tuning (optional) -------------------------------------------
# Max total tokens the agentic loop can spend before stopping.
# AGENTIC_TOKEN_BUDGET=8000
# Alignment check: audit agent reasoning for goal hijacking / indirect injection.
# ALIGNMENT_CHECK=disabled
# ALIGNMENT_CHECK_URL=
# Private SearXNG for the web_search tool. Empty = scrape DuckDuckGo (fragile).
# Set up with: install.sh --with-searxng  (adds the compose service + config).
# Must be an operator-controlled origin: it bypasses the private-IP SSRF guard.
# Requires `json` in the SearXNG settings.yml search.formats list.
SEARXNG_URL=

# Per-tool timeouts (ms). Global default + SQL + plugin web search overrides.
# TOOL_TIMEOUT_MS=15000
# TOOL_TIMEOUT_SQL_MS=30000
# TOOL_TIMEOUT_PLUGIN_WEB_SEARCH_MS=20000

# --- Webhook security ---------------------------------------------------------
# HMAC-SHA256 secret for verifying incoming webhook payloads (/api/webhooks/incoming).
# Required if using the incoming webhook endpoint. Generate with: openssl rand -hex 32
# INCOMING_WEBHOOK_SECRET=

# --- SSO / OIDC (optional — enterprise identity provider) ---------------------
# When all four are set, /api/auth/sso/login redirects to the IdP and
# /api/auth/sso/callback handles the code exchange. Supports HS256 + RS256.
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback

# --- OpenTelemetry (optional) -------------------------------------------------
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Logging ------------------------------------------------------------------
# Log level: debug | info | warn | error (default: info).
# LOG_LEVEL=info
# Audit log retention in days (default: 90; scheduler cleans up daily).
# LOG_RETENTION_DAYS=90

# --- Graceful shutdown --------------------------------------------------------
# Milliseconds to wait for in-flight requests before force-closing (default: 10000).
# SHUTDOWN_TIMEOUT_MS=10000

# --- DB SSL -------------------------------------------------------------------
# Set to false to disable SSL cert verification for managed Postgres (e.g. Supabase).
# DB_SSL_REJECT_UNAUTHORIZED=true

# --- WebSocket CORS -----------------------------------------------------------
# Comma-separated allowed origins for the chat mini-service. Empty = reflect the
# request Origin. NEVER use a wildcard in production.
# Example: https://app.ryas.ai,https://staging.ryas.ai
WS_CORS_ORIGIN=

# --- Client-visible (NEXT_PUBLIC_* are inlined into the browser bundle) -------
# App version shown in the UI footer/sidebar (defaults from package.json at build).
NEXT_PUBLIC_APP_VERSION=2.0.0
# WebSocket port the browser client connects to.
NEXT_PUBLIC_WS_PORT=3003

# --- Cognee (AI memory layer — optional, off until enabled in Settings) ------
# When enabled, chat turns are written to cognee for cross-session memory.
# When disabled, all cognee calls are no-ops (existing RAG is unaffected).
# Cognee reuses the tenant's LLM config (LlmConfig) — no separate API key needed.
#
# The per-org toggle in Settings > AI Memory decides. This variable is only a
# KILL SWITCH on top of it:
#   COGNEE_ENABLED=false  → force off process-wide, Settings ignored (the
#                           scheduler worker sets this itself: the local graph
#                           store's file lock can't be shared between processes)
#   COGNEE_ENABLED=true   → also turns cognee on before an org has any AppConfig
#                           row (i.e. before setup)
#   unset (recommended)   → Settings decides
#
# Cognee state is per-organization: separate client, dataset name
# (org:<id> / org:<id>:kb) and, in local mode, separate directories under
# COGNEE_DATA_DIR/COGNEE_SYSTEM_DIR. Code paths with no org context are no-ops.
# COGNEE_ENABLED=

# Scalability settings (for millions of documents):
# COGNEE_BATCH_SIZE=50          # documents per cognify pipeline run
# COGNEE_MAX_RETRIES=3          # retry on transient FK/lock errors

# Production backend for the IN-PROCESS SDK path only (ignored when
# COGNEE_SERVER_URL is set — the server owns its own storage): Postgres +
# pgvector, scales to millions.
# COGNEE_DB_PROVIDER=postgres
# COGNEE_DB_URL=postgresql://user:password@localhost:5432/cognee

# Dev backend for the IN-PROCESS SDK path (default — SQLite + LanceDB + Kuzu,
# zero services):
# Local storage dirs for cognee data + system files:
# COGNEE_DATA_DIR=.cognee/data
# COGNEE_SYSTEM_DIR=.cognee/system

# --- Cognee API server (THE ONLY backend since 2026-09-24) --------------------
# Point this at the cognee v1.6.0 API server. docker-compose.yml and install.sh both
# ship it as the `cognee` sidecar, so compose installs already have it set correctly.
#
# THERE IS NO FALLBACK. The in-process `@cognee/cognee-ts` SDK has been REMOVED from
# this project. Two cognee lineages writing one store is not a configuration risk, it
# is a corruption mechanism, and this deployment already paid for it: a LanceDB
# collection sized 1536 while the configured embedder returned 384 (so every vector
# write silently fell back to JSON and the pgvector leg returned nothing), and a graph
# holding 0 nodes after a write that reported success. See docs/cognee-http-migration.md
# and, for why the bindings were rejected, scripts/cognee-upgrade-check.md.
#
# Leave this EMPTY to run with memory OFF. That is a supported state: every cognee call
# degrades to a no-op, and the Settings card reports "Disconnected" rather than
# pretending the feature works.
# COGNEE_SERVER_URL=http://cognee:8000
#
# Set only when the server runs with authentication enabled.
# COGNEE_SERVER_API_KEY=
#
# --- Server-side latency options (MEASURED, and they matter a lot) ------------
# These configure the SIDECAR, not this app (docker-compose.yml passes them), and the
# defaults are wrong for our usage. Measured against a real store before setting them:
#   write 22-30s, search 24-95s — two consecutive searches took 81s each.
# The server log showed retrieval was NOT the cost: "Found 3 chunks from vector search"
# took 49 MILLISECONDS, then `SessionTurnAnalysis` ran, failed schema validation and
# retried ("litellm_native validation retry 1/3: 1 validation error for
# SessionTurnAnalysis", six times in one log). With all three disabled: write 9s,
# search 0.21s, same facts recalled.
#   COGNEE_AUTO_FEEDBACK=false   per-turn feedback analysis, an LLM call per turn
#   COGNEE_IMPROVE_AUTO=false    the automatic improve() pass after every remember()
#   (USAGE_LOGGING is set false in compose directly; the licence is flat, so per-turn
#    usage rows have no consumer here.)
# COGNEE_AUTO_FEEDBACK=false
# COGNEE_IMPROVE_AUTO=false

# --- Local embeddings (semantic RAG + cognee), no hosted key needed --------------
# The `local-embeddings` compose service serves an OpenAI-compatible
# /v1/embeddings endpoint backed by a local sentence-transformers model. It ships
# in the default install because WITHOUT it `resolveQueryEmbedding` returns null
# and retrieval silently degrades to lexical (BM25) only — while still reporting a
# healthy-looking similarity score, so nothing appears broken.
#
# The model is 384-dim and `DocumentChunk.embedding` is declared `vector(384)`, so
# they match by construction. THE DIMENSIONS MUST AGREE: on a mismatch every vector
# write silently falls back to `embeddingJson`, the pgvector leg returns an empty
# candidate set, and RRF fuses BM25 against nothing. If you change the model, change
# the column to the same width and re-embed every document:
#   ALTER TABLE "DocumentChunk" DROP COLUMN embedding;
#   ALTER TABLE "DocumentChunk" ADD COLUMN embedding vector(<new dims>);
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#
# The app must be allowed to reach the compose service by name: isBlockedHost()
# refuses private/loopback hosts to prevent SSRF, and that guard applies to
# self-hosted inference too. Compose sets this default; override only if you point
# `embeddingBaseUrl` elsewhere (add that host, comma-separated).
# LLM_ALLOWED_HOSTS=local-embeddings
#
# cognee uses the SAME server but has its OWN dimension setting — cognee stores
# vectors separately from `DocumentChunk`, so the 384 column does not constrain it.
# A wrong value here fails every write with a pydantic "List should have at least
# N items" error that names the wrong cause.
#
# MEASURED: litellm dispatches on PROVIDER, not ENDPOINT. With provider `openai`
# and an EMPTY key it ignores the endpoint and calls api.openai.com, failing every
# write with `No credentials for provider: openai` — a message that blames OpenAI
# while the real fault is our local server never being contacted. The default key
# below is a non-empty placeholder to keep it on the OpenAI-compatible path; the
# local server never validates it.
# COGNEE_EMBEDDING_PROVIDER=openai
# COGNEE_EMBEDDING_ENDPOINT=http://local-embeddings:8081/v1
# COGNEE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# COGNEE_EMBEDDING_DIMENSIONS=384
# COGNEE_EMBEDDING_API_KEY=local-no-auth

# --- SSO: OIDC (OpenID Connect) -------------------------------------------------
# When set, a "Sign in with SSO" button appears on the login page.
# Auto-discovers endpoints from {OIDC_ISSUER}/.well-known/openid-configuration.
# Works with Keycloak, Azure AD/Entra ID, Auth0, Google Workspace, etc.
# See docs/sso-setup.md for provider-specific setup instructions.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Which organization an SSO-provisioned user belongs to (applies to OIDC AND
# SAML). REQUIRED once the deployment has more than one organization. With
# exactly one org it may be left blank and is resolved unambiguously; with
# several, SSO login REFUSES rather than guessing a tenant — attaching a user to
# the wrong org would be a cross-tenant leak. Value is an Organization id.
SSO_ORGANIZATION_ID=

# --- SSO: SAML 2.0 --------------------------------------------------------------
# When set, a "Sign in with SAML" button appears on the login page.
# Works with AD FS, Shibboleth, Okta SAML, and any SAML 2.0 IdP.
# SP metadata is available at /api/auth/saml/metadata (give this URL to IdP admin).
# See docs/sso-setup.md for provider-specific setup instructions.
SAML_SP_ENTITY_ID=
SAML_SP_CALLBACK_URL=
SAML_IDP_ENTRY_POINT=
SAML_IDP_CERT=
SAML_IDP_METADATA_URL=
SAML_SP_CERT=
SAML_SP_PRIVATE_KEY=

# --- License Validator ----------------------------------------------------------
# URL of the License-Validator service. When set, signup requires a valid license key.
# The validator is a separate FastAPI service (see License-Validator repo).
LICENSE_VALIDATOR_URL=http://localhost:9000
LICENSE_PRODUCT=ryasai-chatbot

# Shared secret for the license webhook receiver (/api/webhooks/license).
# The License-Validator sends this in the x-webhook-secret header.
# Generate with: openssl rand -hex 32
LICENSE_WEBHOOK_SECRET=

# Ed25519 public key (DER hex) used to VERIFY signed License-Validator responses.
# OPTIONAL at boot, but licensing FAILS CLOSED without it (responses cannot be
# verified). NEVER reuse a key across deployments — provision per-install:
#   install.sh --license-signing-public-key <hex>
# Generate the matching private key on the validator side:
#   openssl genpkey -algorithm ed25519
#   openssl pkey -pubout  (then DER-hex-encode the SPKI, e.g. via openssl asn1parse)
LICENSE_SIGNING_PUBLIC_KEY=

# Internal shared secret the app sends to the License-Validator's
# POST /internal/licenses/generate when a paid webhook needs to issue a license.
# Must match the validator's configured internal secret. Without it, license
# issuance fails closed (customers pay but no license is issued — do not deploy
# billing without it). Generate with: openssl rand -hex 32
LICENSE_INTERNAL_SECRET=

# --- Billing (QRIS checkout via Midtrans Snap) ---------------------------------
# All optional at boot — the purchase API/UI fail closed without them and a
# consolidated warning prints at startup. Required before charging real customers.
#
# Server-side key for creating Snap transactions + verifying webhooks
# ("SB-Midserver-..." prefix in sandbox):
#   sandbox: https://dashboard.sandbox.midtrans.com/settings/config_info
#   prod:    https://dashboard.midtrans.com/settings/config_info
MIDTRANS_SERVER_KEY=
# Client key embedded in the browser bundle to load Snap.js:
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# true = app.midtrans.com, false = app.sandbox.midtrans.com. Keep both server
# and NEXT_PUBLIC values in sync or checkout/webhooks disagree on environment.
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# ---------------------------------------------------------------------------
# LLM transport
# ---------------------------------------------------------------------------
# Per-attempt LLM request timeout, milliseconds (default 30000).
# Raise this for REASONING models: they spend the budget on hidden "thinking"
# tokens before emitting content, so a single request can legitimately take tens
# of seconds. Measured on a reasoning gateway during the 2026-09 eval: 6.5s for a
# trivial prompt, 6.4s for an eval judge prompt — four concurrent judge calls
# exceeded 30s and the run died as `DOMException TimeoutError` with an empty
# stack, which looks like a harness bug rather than a too-tight timeout.
# Does NOT affect streaming (LLM_STREAM_TIMEOUT_MS).
LLM_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Self-hosted inference hosts (SSRF blocklist opt-in)
# ---------------------------------------------------------------------------
# Comma-separated hostnames/IPs allowed even though they resolve to a PRIVATE
# address — for self-hosted models (Ollama, vLLM, LM Studio, a local
# sentence-transformers server, an on-prem gateway).
#
# The default blocklist refuses localhost, 127.0.0.0/8, 10/8, 172.16/12,
# 192.168/16 and cloud metadata endpoints, which is correct for a SaaS
# deployment calling a public API but makes self-hosting impossible.
# LLM_ALLOW_BLOCKED_HOSTS is NOT an alternative: it is a test-only marker that
# env-schema.ts refuses when NODE_ENV=production.
#
# Matching is EXACT after lowercasing (port ignored) — never a wildcard or
# suffix, so `evil-ollama.com` does not match `ollama` and a typo cannot open a
# whole subnet. Examples: LLM_ALLOWED_HOSTS=ollama
#                            LLM_ALLOWED_HOSTS=ollama,10.0.0.7,embed.internal
#                            LLM_ALLOWED_HOSTS=127.0.0.1,localhost
LLM_ALLOWED_HOSTS=
