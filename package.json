    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "c8": "^10.1.3",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "@cognee/cognee-ts"
  ]
