{
  "name": "@ryasai/chatbot-sdk",
  "version": "0.1.0",
  "description": "Type-safe SDK for building ryasai Chatbot plugin tools.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
